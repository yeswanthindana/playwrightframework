# Copy this file to deskmeet.env and replace local values. Never commit deskmeet.env.
BASE_URL=https://your-deskmeet-application.example.com/
TEST_USERNAME=replace-with-test-membername
TEST_PASSWORD=replace-with-test-password
CREATED_BY=50

# Add DB_* variables when Deskmeet tests require direct database access.

# Jira synchronization remains off unless explicitly enabled.
JIRA_ENABLED=false
JIRA_IMPORT_ENABLED=false
JIRA_LINK_STORIES_ENABLED=false
JIRA_STORY_LINK_TYPE_ID=10071
JIRA_ASSIGN_SPRINTS_ENABLED=false
JIRA_BASE_URL=https://aether.atlassian.net
JIRA_EMAIL=replace-with-jira-account-email
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_EXECUTION_STATUS_FIELD_ID=customfield_10284
JIRA_EXECUTION_STATUS_FIELD_FORMAT=multiselect
JIRA_STATUS_PASSED_VALUE=Passed
JIRA_STATUS_FAILED_VALUE=Failed
JIRA_STATUS_SKIPPED_VALUE=No Run
JIRA_STATUS_TIMED_OUT_VALUE=Failed
JIRA_STATUS_INTERRUPTED_VALUE=No Run
JIRA_EXECUTED_BY_FIELD_ID=customfield_10285
# Optional: leave blank to resolve the email/token account automatically.
JIRA_EXECUTED_BY_ACCOUNT_ID=
JIRA_EXECUTED_BY_IS_ARRAY=true
JIRA_ENVIRONMENT_FIELD_ID=environment
JIRA_ENVIRONMENT_FIELD_FORMAT=adf
JIRA_ADD_COMMENT=true
JIRA_UPLOAD_TEST_ATTACHMENTS=true
JIRA_UPLOAD_FAILURE_ATTACHMENTS=false
JIRA_FAIL_ON_ERROR=false
