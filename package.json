{
    "name": "quality-engineering",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "directories": {
        "test": "tests"
    },
    "dependencies": {
        "@faker-js/faker": "^10.5.0",
        "ajv": "^8.20.0",
        "allure-js-commons": "^3.10.2",
        "chalk": "^5.6.2",
        "dotenv": "^17.4.2",
        "exceljs": "^3.4.0",
        "pg": "^8.22.0",
        "playwright": "^1.61.1",
        "playwright-core": "^1.61.1",
        "undici-types": "^8.3.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "@reportportal/agent-js-playwright": "^5.4.2",
        "@types/dotenv": "^6.1.1",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "allure-commandline": "^2.43.0",
        "allure-playwright": "^3.10.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "monocart-reporter": "^2.12.4",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "clean:results": "rm -rf allure-report allure-results test-results",
        "pretest": "npm run clean:results",
        "test": "playwright test",
        "typecheck": "tsc --noEmit",
        "test:headed": "npm run clean:results && playwright test --headed",
        "test:debug": "playwright test --debug",
        "test:ui": "playwright test --ui",
        "test:lastfailed": "playwright test --last-failed",
        "test:list": "playwright test --list",
        "test:qa": "npm run clean:results && cross-env TEST_ENV=qa playwright test",
        "test:dev": "npm run clean:results && cross-env TEST_ENV=dev playwright test",
        "test:deskmeet": "npm run clean:results && cross-env TEST_ENV=deskmeet playwright test",
        "test:jira": "cross-env JIRA_ENABLED=true playwright test",
        "jira:import": "node scripts/jira/import-test-cases.mjs",
        "jira:sync-map": "node scripts/jira/sync-test-case-mapping.mjs",
        "test:smoke": "npm run clean:results && playwright test --grep @smoke",
        "report": "playwright show-report",
        "allure:generate": "mkdir -p allure-results/history && cp -r allure-report/history/. allure-results/history/ 2>/dev/null || true && allure generate allure-results --clean -o allure-report",
        "allure:open": "allure open allure-report",
        "allure:serve": "allure serve allure-results",
        "report:allure": "npm run allure:generate && npm run allure:open",
        "report:monocart": "xdg-open test-results/monocart-report/index.html || open test-results/monocart-report/index.html"
    },
    "repository": {
        "type": "git",
        "url": "git+https://bitbucket.org/aether_technologies/quality-engineering.git"
    },
    "keywords": [],
    "author": "Aether Technologies Quality Engineering Team",
    "license": "ISC",
    "bugs": {
        "url": "https://bitbucket.org/aether_technologies/quality-engineering/issues"
    },
    "homepage": "https://bitbucket.org/aether_technologies/quality-engineering#readme"
}
